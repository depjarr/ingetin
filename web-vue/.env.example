# Salin jadi .env lalu isi. Jangan commit file .env.
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_ATAU_PUBLISHABLE_KEY>

# Hasil `npx web-push generate-vapid-keys` → Public Key (BUKAN private key)
VITE_VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
